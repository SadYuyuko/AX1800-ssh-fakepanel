#!/bin/sh

REPO="https://raw.githubusercontent.com/SadYuyuko/AX1800-ssh-fakepanel/main"
DEST="/usr/bin/panel"

echo "0 - 直接安装"
echo "1 - 安装并加入ssh连接自动展示"
echo ""
read -p "Select [0]: " CHOICE

echo "Downloading panel..."
curl -fsSL "$REPO/panel" -o "$DEST" || { echo "Download failed"; exit 1; }
chmod +x "$DEST"

if [ "$CHOICE" = "1" ]; then
    grep -q "^panel$" /etc/profile 2>/dev/null || echo "panel" >> /etc/profile
    echo "Installed + added to /etc/profile"
else
    echo "Installed to $DEST"
fi

echo "Run: panel"
